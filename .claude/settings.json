{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/skill-sync-hint.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/related-tests.js",
            "statusMessage": "Gerelateerde tests draaien..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/kennisbank-tag-check.js",
            "statusMessage": "Kennisbank-tags controleren..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/prompt-eval-hint.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx vitest run --reporter=dot 2>&1 | tail -10"
          }
        ]
      }
    ]
  }
}
